#!/usr/bin/env bash
# This file contains scripts that are executed at different stages of package installation/upgrade/removal

# Color definitions for status messages
blueDark="\e[1;38;5;33m"     # Bold dark blue
mediumBlue="\e[1;38;5;32m"   # Bold medium blue
lightBlue="\e[1;38;5;39m"    # Bold light blue
cyan="\e[1;38;5;45m"         # Bold cyan
white="\e[1;97m"             # Bold white
reset="\e[0m"                # Reset text formatting

# Print status messages
printMsg() {
    local message=$1
    echo -e "${blueDark}[${lightBlue}plymouth-community${blueDark}]${reset} ${cyan}→${reset} ${white}${message}${reset}"
}

syncBootMessages() {
    local configFile="/etc/biglinux/plymouth-community.conf"
    local themeScript="/usr/share/plymouth/themes/community/animated-boot.script"

    [ -f "$themeScript" ] || return 0

    if grep -Eq '^[[:space:]]*SHOW_BOOT_MESSAGES[[:space:]]*=[[:space:]]*true([[:space:]]*(#.*)?)?$' "$configFile" 2>/dev/null; then
        sed -i \
            -e 's|^[[:space:]]*#[[:space:]]*\(Plymouth\.SetDisplayMessageFunction.*\)|\1|' \
            -e 's|^[[:space:]]*#[[:space:]]*\(Plymouth\.SetHideMessageFunction.*\)|\1|' \
            -e 's|^[[:space:]]*#[[:space:]]*\(Plymouth\.SetUpdateStatusFunction.*\)|\1|' \
            "$themeScript"
    else
        sed -i \
            -e 's|^[[:space:]]*\(Plymouth\.SetDisplayMessageFunction.*\)|# \1|' \
            -e 's|^[[:space:]]*\(Plymouth\.SetHideMessageFunction.*\)|# \1|' \
            -e 's|^[[:space:]]*\(Plymouth\.SetUpdateStatusFunction.*\)|# \1|' \
            "$themeScript"
    fi
}

# Function executed before package installation
# pre_install() {
#     printMsg "Preparing to install the package..."
#     # Example: Check for system dependencies
#     # if ! command -v required_command &> /dev/null; then
#     #     printMsg "Error: required_command not found. Please install it before continuing."
#     #     exit 1
#     # fi
# }

# Function executed after package installation
post_install() {
    printMsg "Configuring Plymouth after installation..."
    
    # add plymouth to mkinitcpio
    if ! grep -q plymouth /etc/mkinitcpio.conf; then
        printMsg "Adding Plymouth to mkinitcpio hooks..."
        sed -i '/HOOKS=/s/"/"plymouth /' /etc/mkinitcpio.conf
        sed -i '/HOOKS=/s/(/(plymouth /' /etc/mkinitcpio.conf
    fi

    # Default: keep the boot animation clean unless enabled in settings.
    mkdir -p /etc/biglinux
    if [ ! -f /etc/biglinux/plymouth-community.conf ]; then
        printf '# BigCommunity Plymouth settings\nSHOW_BOOT_MESSAGES=false\n' > /etc/biglinux/plymouth-community.conf
        chmod 0644 /etc/biglinux/plymouth-community.conf
    fi

    syncBootMessages

    printMsg "Setting default Plymouth theme..."
    plymouth-set-default-theme -R community

    # Enable optional systemd log service
    printMsg "Enabling optional Plymouth log service..."
    systemctl enable plymouth-show-log-comm.service
    
    printMsg "Plymouth installation completed successfully!"
}

# Function executed before package upgrade
# pre_upgrade() {
#     printMsg "Preparing to upgrade the package..."
#     # Example: Backup configuration files
#     # cp /etc/mypackage/config.conf /etc/mypackage/config.conf.bak
#     # printMsg "Configuration backup created"
# }

# Function executed after package upgrade
post_upgrade() {
    printMsg "Upgrading Plymouth configuration..."
    post_install
}

# Function executed before package removal
pre_remove() {
    printMsg "Preparing to remove Plymouth..."
    # Disable plymouth service before removal
    printMsg "Disabling Plymouth service..."
    systemctl disable plymouth-show-log-comm.service
}

# Function executed after package removal
post_remove() {
    printMsg "Cleaning up after Plymouth removal..."
    
    # Remove plymouth from mkinitcpio hooks
    printMsg "Removing Plymouth from mkinitcpio hooks..."
    sed -i 's/plymouth //' /etc/mkinitcpio.conf
    
    # Regenerate initramfs without plymouth
    printMsg "Regenerating initramfs without Plymouth..."
    mkinitcpio -P
    
    printMsg "Plymouth has been removed from the system."
    printMsg "Note: If you want to completely remove all Plymouth configurations, you may need to:"
    printMsg "1. Check /etc/plymouth/ for any remaining configuration files"
    printMsg "2. Remove any Plymouth-related themes in /usr/share/plymouth/themes/"
}
